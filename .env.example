# Provider selection: ollama | mock
STORYBOARD_PROVIDER=ollama

# Local Ollama configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT_MS=180000

# Fall back to deterministic mock output when Ollama is unavailable or invalid.
STORYBOARD_MOCK_FALLBACK=true

# Prototype request limits
STORYBOARD_MAX_REQUEST_BYTES=16384

# Image generation: mock | replicate
IMAGE_PROVIDER=mock

# Replicate is only used when IMAGE_PROVIDER=replicate.
REPLICATE_API_TOKEN=
REPLICATE_MODEL=stability-ai/sdxl
IMAGE_GENERATION_TIMEOUT_MS=120000
IMAGE_MAX_REQUEST_BYTES=65536
