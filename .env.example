# Provider selection: ollama | mock
STORYBOARD_PROVIDER=ollama

# Local Ollama configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_MS=180000

# Fall back to deterministic mock output when Ollama is unavailable or invalid.
STORYBOARD_MOCK_FALLBACK=false

# Prototype request limits
STORYBOARD_MAX_REQUEST_BYTES=16384

# Image generation: mock | replicate
IMAGE_PROVIDER=mock

# Replicate is used for hosted images and experimental storyboard video.
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-2-klein-4b
IMAGE_GENERATION_TIMEOUT_MS=120000
IMAGE_MAX_REQUEST_BYTES=32000000
# Optional current USD price per rendered image and its source/date. Both are required.
# IMAGE_ESTIMATE_USD_PER_IMAGE=
# IMAGE_ESTIMATE_PRICE_BASIS=

# Shared inference backend: ollama | vercel (takes precedence over STORYBOARD_PROVIDER)
# LLM_PROVIDER disables mock fallback for reproducible runs.
LLM_PROVIDER=ollama
LLM_TIMEOUT_MS=120000
AI_GATEWAY_MODEL=google/gemma-4-26b-a4b-it
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=
# Optional USD per million tokens, from your current model pricing.
# Set both to enable estimates; unset values leave costs unknown.
# AI_GATEWAY_INPUT_PER_MILLION=
# AI_GATEWAY_OUTPUT_PER_MILLION=

# English voice notes: local | groq (server-controlled; restart after changing).
ASR_PROVIDER=local
# Local uses an isolated Python environment and pre-downloaded Whisper Turbo.
ASR_PYTHON=.venv-asr/bin/python
ASR_TIMEOUT_MS=180000
GROQ_API_KEY=
# Set HF_HOME to an existing model cache location if using an external drive.

# Experimental Wan 2.2 5B Fast video runs only on Replicate.
# Reuses REPLICATE_API_TOKEN; needs a persistent Node server and FFmpeg for assembly.
# VIDEO_FFMPEG=/opt/homebrew/bin/ffmpeg
# VIDEO_OUTPUT_DIR=.cache/videos
