{
  "name": "storyboard-orchestrator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ollama": "OLLAMA_INTEGRATION=true vitest run tests/integration/ollamaReal.test.ts",
    "test:all": "npm run test && npm run test:e2e",
    "eval": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON evaluation/cli/index.ts",
    "eval:doctor": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON evaluation/cli/index.ts doctor",
    "eval:smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON evaluation/cli/index.ts run evaluation/configs/smoke/llm.json",
    "evaluate": "node --env-file-if-exists=.env --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON evaluation/compare.ts",
    "test:llm:ollama": "LLM_INTEGRATION=ollama node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/integration/llmBackends.test.ts",
    "test:llm:vercel": "LLM_INTEGRATION=vercel node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/integration/llmBackends.test.ts"
  },
  "dependencies": {
    "next": "15.5.19",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^4.4.3",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.22.0",
    "eslint-config-next": "15.5.19",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
